    {
      "Step": 2,
      "Action": "Inject Are Logic into server lifecycle",
      "Code": "import { updateHeuristics } from './arelogic/heuristic.engine'; setInterval(()=>{ global.H = updateHeuristics(global.H, M, E); },100);"
