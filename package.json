{
  "name": "rpgjs",
  "version": "5.0.0",
  "engines": {
    "node": ">=18.x"
  },
  "description": "A RPG and MMORPG game engine for the web",
  "dependencies": {
    "bumpp": "^10.0.3",
    "canvas": "^2.11.2",
    "concurrently": "^7.6.0",
    "default-composer": "^0.6.0",
    "execa": "^5.1.1",
    "tsc-esm-fix": "^2.20.14",
    "tsx": "^4.7.1",
    "vite": "^6.1.1",
    "vite-plugin-dts": "^4.5.0",
    "vue": "^3.2.47",
    "wait-on": "^7.2.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.24",
    "@types/wait-on": "^5.3.4",
    "axios": "^1.5.0",
    "git-parse": "^3.0.1",
    "jsdom": "^21.1.1",
    "lerna": "^6.6.1",
    "typescript": "^5.3.3",
    "vitest": "^1.2.2"
  },
  "scripts": {
    "build": "tsx bin/build.ts",
    "dev": "tsx bin/dev.ts",
    "release": "bumpp packages/*/package.json",
    "postinstall": "npm run build",
    "test": "RPGJS_TEST=1 vitest --config ./packages/compiler/src/test/vitest.config.ts && cd ./packages/compiler && npm test",
    "dev:doc": "cd docs && npm run dev",
    "doc:build": "cd docs && npm run build",
    "fix-esm": "tsc-esm-fix  --target='packages/*/lib/**/*.js' --dirnameVar=false && tsc-esm-fix  --target='packages/plugins/agones/matchmaker/lib/*.js'"
  },
  "repository": {
    "type": "git",
    "url": ""
  },
  "keywords": [
    "rpg",
    "mmorpg",
    "framework"
  ],
  "author": "Samuel Ronce",
  "license": "MIT",
  "type": "module"
}
