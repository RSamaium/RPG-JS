<DOMContainer width="100%" height="100%" class="action-battle-actionbar-root" controls={controls}>
  <div class="action-battle-actionbar">
    @if (visibleActionBarSlots().length) {
    <div
      class="rpg-ui-hotbar action-battle-actionbar-plate"
      style={{ "--rpg-ui-hotbar-slots": Math.max(1, visibleActionBarSlots().length) }}
    >
      <div class="rpg-ui-hotbar-track action-battle-actionbar-track">
        @for ((slot, visibleIndex) of visibleActionBarSlots()) {
          <div
            class="rpg-ui-hotbar-slot action-battle-actionbar-slot"
            data-selected={selectedSlotIndex() === slot.index ? "true" : "false"}
            data-disabled={isSlotDisabled(slot) ? "true" : "false"}
            data-type={slot.type}
            tabindex={slot.index}
            aria-label={slotAriaLabel(slot)}
            click={onSelectSlot(slot.index)}
          >
            <span class="rpg-ui-hotbar-key action-battle-actionbar-key">{slot.label}</span>
            @if (slot.type === "skill" && slot.skill?.icon) {
              <DOMSprite sheet={iconSheet(slot.skill.icon)} width="60px" height="60px" scale={2} objectFit="contain" />
            } @else if (slot.type === "item" && slot.item?.icon) {
              <DOMSprite sheet={iconSheet(slot.item.icon)} width="60px" height="60px" scale={2} objectFit="contain" />
            } @else if (slot.type === "skill" && slot.skill) {
              <span class="action-battle-actionbar-fallback">✦</span>
              <span class="rpg-ui-hotbar-text action-battle-actionbar-text">{slot.skill.name}</span>
            } @else if (slot.type === "item" && slot.item) {
              <span class="rpg-ui-hotbar-text action-battle-actionbar-text">{slot.item.name}</span>
            }
            @if (slot.type === "skill" && (slot.skill?.spCost ?? 0) > 0) {
              <span class="action-battle-actionbar-cost">{slot.skill.spCost} SP</span>
            }
            @if (slot.type === "item" && slot.item) {
              <span class="rpg-ui-hotbar-count action-battle-actionbar-count">x{getItemQuantity(slot.item)}</span>
            }
            @if (slot.type === "skill" && cooldownLabel(slot.skill)) {
              <span class="action-battle-actionbar-cooldown">{cooldownLabel(slot.skill)}</span>
            }
          </div>
        }
      </div>
    </div>
    }
  </div>
  @if (wheelOpen()) {
    <div class="action-battle-hotbar-wheel-backdrop">
      <div class="action-battle-hotbar-wheel">
        <div class="action-battle-hotbar-wheel-center">{wheelLabel()}</div>
        @for ((slot, index) of actionBarSlots()) {
          <div
            class="action-battle-hotbar-wheel-slot"
            data-selected={wheelSlot() === index ? "true" : "false"}
            data-disabled={isSlotDisabled(slot) ? "true" : "false"}
            data-empty={hasSlotEntry(slot) ? "false" : "true"}
            style={wheelSlotStyle(index)}
          >
            <span class="rpg-ui-hotbar-key">{slot.label}</span>
            @if (slot.type === "skill" && slot.skill?.icon) {
              <DOMSprite sheet={iconSheet(slot.skill.icon)} width="54px" height="54px" scale={2} objectFit="contain" />
            } @else if (slot.type === "item" && slot.item?.icon) {
              <DOMSprite sheet={iconSheet(slot.item.icon)} width="54px" height="54px" scale={2} objectFit="contain" />
            } @else {
              <span>{slot.skill?.name || slot.item?.name || t("rpg.menu.empty")}</span>
            }
          </div>
        }
      </div>
    </div>
  }
</DOMContainer>

<style>
  .action-battle-actionbar-root {
    pointer-events: none;
  }

  .action-battle-actionbar {
    position: absolute;
    left: 12px;
    right: 12px;
    bottom: 12px;
    pointer-events: auto;
    display: flex;
    justify-content: center;
  }

  .action-battle-actionbar-plate {
    width: min(760px, 100%);
    --rpg-ui-hotbar-size: clamp(38px, 8vw, 52px);
  }

  .action-battle-actionbar-track {
    min-width: 0;
  }

  .action-battle-actionbar-slot {
    width: clamp(48px, 7vw, 62px);
  }

  .action-battle-actionbar-fallback {
    font-size: 1.35rem;
    color: var(--rpg-ui-accent);
    text-shadow: 0 0 12px color-mix(in srgb, var(--rpg-ui-accent), transparent 25%);
  }

  .action-battle-actionbar-cost {
    position: absolute;
    right: 3px;
    bottom: 2px;
    padding: 1px 3px;
    border-radius: 4px;
    background: rgb(4 10 20 / 82%);
    color: #86caff;
    font-size: 8px;
    font-weight: 900;
    line-height: 1;
  }

  .action-battle-actionbar-cooldown {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    border-radius: inherit;
    background: rgb(5 10 18 / 68%);
    color: white;
    font-weight: 800;
    font-size: 0.82rem;
    text-shadow: 0 1px 3px rgb(0 0 0 / 85%);
  }

  .action-battle-hotbar-wheel-backdrop {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    background: rgb(2 7 14 / 38%);
    pointer-events: none;
  }

  .action-battle-hotbar-wheel {
    position: relative;
    width: min(72vw, 430px);
    aspect-ratio: 1;
    border-radius: 50%;
    border: 3px solid var(--rpg-ui-border-light);
    background:
      radial-gradient(circle, rgb(17 28 43 / 96%) 0 23%, transparent 24%),
      radial-gradient(circle, rgb(9 18 31 / 88%) 0 64%, rgb(3 8 16 / 92%) 65% 100%);
    box-shadow: 0 20px 65px rgb(0 0 0 / 58%);
  }

  .action-battle-hotbar-wheel-center {
    position: absolute;
    inset: 38%;
    display: grid;
    place-items: center;
    color: white;
    font-weight: 800;
    text-align: center;
    text-shadow: 0 2px 4px black;
  }

  .action-battle-hotbar-wheel-slot {
    position: absolute;
    width: 72px;
    height: 72px;
    translate: -50% -50%;
    display: grid;
    place-items: center;
    overflow: hidden;
    border: 2px solid var(--rpg-ui-border-dark);
    border-radius: 16px;
    background: var(--rpg-ui-surface);
    color: var(--rpg-ui-text);
    font-size: 0.68rem;
    text-align: center;
  }

  .action-battle-hotbar-wheel-slot[data-selected="true"] {
    z-index: 2;
    scale: 1.18;
    border-color: var(--rpg-ui-accent);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--rpg-ui-accent), transparent 58%);
  }

  .action-battle-hotbar-wheel-slot[data-disabled="true"],
  .action-battle-hotbar-wheel-slot[data-empty="true"] {
    filter: grayscale(1);
    opacity: 0.52;
  }
</style>

<script>
  import { signal, computed, mount } from "canvasengine";
  import { inject } from "@rpgjs/client";
  import { RpgClientEngine } from "@rpgjs/client";
  import {
    actionBattleHotbarSlots,
    actionBattleSkillLoadout,
    actionBattleUiOptions,
    startTargeting
  } from "../ui/state";
  import { activateActionBattleSkill } from "../ui/skill-activation";

  const engine = inject(RpgClientEngine);
  const { t } = engine.i18n();
  const { data } = defineProps();
  const ACTION_BAR_SIZE = 10;
  const SLOT_LABELS = ["1", "2", "3", "4", "5", "6", "7", "8", "9", "0"];

  const selectedSlotIndex = signal(-1);
  const wheelOpen = signal(false);
  const wheelSlot = signal(-1);
  const clock = signal(Date.now());

  const uiOptions = computed(() => actionBattleUiOptions());
  const showItems = computed(() => {
    const mode = uiOptions().actionBar?.mode || "both";
    return mode === "items" || mode === "both";
  });
  const showSkills = computed(() => {
    const mode = uiOptions().actionBar?.mode || "both";
    return mode === "skills" || mode === "both";
  });

  const iconSheet = (iconId) => ({
    definition: engine.getSpriteSheet(iconId),
    playing: "default"
  });

  const resolveProp = (value) => typeof value === "function" ? value() : value;
  const actionBarData = computed(() => {
    const guiData = resolveProp(data) || {};
    const guiSlots = resolveProp(guiData.slots);
    const guiSkills = resolveProp(guiData.skills);
    return {
      ...guiData,
      items: resolveProp(guiData.items) || [],
      skills:
        Array.isArray(guiSkills) && guiSkills.length
          ? guiSkills
          : actionBattleSkillLoadout(),
      slots:
        Array.isArray(guiSlots) && guiSlots.length
          ? guiSlots
          : actionBattleHotbarSlots()
    };
  });

  const actionBarSlots = computed(() => {
    const assignedSlots = actionBarData().slots;
    if (Array.isArray(assignedSlots)) {
      return Array.from({ length: ACTION_BAR_SIZE }, (_, index) => {
        const slot = assignedSlots[index];
        if (!slot) {
          return {
            type: "empty",
            skill: null,
            item: null,
            sourceIndex: -1,
            label: SLOT_LABELS[index]
          };
        }
        return {
          ...slot,
          skill: slot.skill || null,
          item: slot.item || null,
          sourceIndex: index,
          label: SLOT_LABELS[index]
        };
      });
    }
    const entries = [];
    if (showSkills()) {
      (actionBarData().skills || []).forEach((skill, index) => {
        entries.push({
          type: "skill",
          skill,
          item: null,
          sourceIndex: index
        });
      });
    }
    if (showItems()) {
      (actionBarData().items || []).forEach((item, index) => {
        entries.push({
          type: "item",
          skill: null,
          item,
          sourceIndex: index
        });
      });
    }
    const slots = entries
      .slice(0, ACTION_BAR_SIZE)
      .map((entry, index) => ({
        ...entry,
        label:
          entry.type === "skill" && entry.skill?.key
            ? String(entry.skill.key).toUpperCase()
            : SLOT_LABELS[index]
      }));
    while (slots.length < ACTION_BAR_SIZE) {
      slots.push({
        type: "empty",
        skill: null,
        item: null,
        sourceIndex: -1,
        label: SLOT_LABELS[slots.length]
      });
    }
    return slots;
  });
  const hasSlotEntry = (slot) => slot.type === "skill" || slot.type === "item";
  const visibleActionBarSlots = computed(() =>
    actionBarSlots().filter(hasSlotEntry)
  );

  const isSlotDisabled = (slot) => {
    if (!hasSlotEntry(slot)) return true;
    const entry = slot.type === "skill" ? slot.skill : slot.item;
    return !entry || !entry.usable;
  };

  const getItemQuantity = (item) => {
    if (!item) return 0;
    if (typeof item.quantity === "function") return item.quantity();
    return item.quantity || 0;
  };

  const cooldownLabel = (skill) => {
    const remaining = Number(skill?.readyAt ?? 0) - clock();
    if (remaining <= 0) return "";
    return `${Math.max(1, Math.ceil(remaining / 1000))}s`;
  };

  const currentDirection = () => {
    const player = engine.scene?.getCurrentPlayer?.();
    if (typeof player?.getDirection === "function") return player.getDirection();
    if (typeof player?.direction === "function") return player.direction();
    return player?.direction ?? "down";
  };

  const slotAriaLabel = (slot) => {
    const entry = slot.type === "skill" ? slot.skill : slot.item;
    return `${slot.label}: ${entry?.name || t("rpg.menu.empty")}`;
  };

  const selectSlot = (index) => {
    const slot = actionBarSlots()[index];
    if (!slot || !hasSlotEntry(slot)) return;
    if (slot.type === "skill") {
      activateActionBattleSkill(slot.skill, {
        direction: currentDirection(),
        use: () =>
          engine.processAction("action-battle:use-hotbar", { slot: index }),
        target: (offset) => startTargeting(slot.skill, offset)
      });
      return;
    }
    if (slot.item?.usable) {
      engine.processAction("action-battle:use-hotbar", { slot: index });
    }
  };

  const onSelectSlot = (index) => () => {
    selectedSlotIndex.set(index);
    selectSlot(index);
  };

  const controls = {};

  const wheelSlotStyle = (index) => {
    const angle = (index / 10) * Math.PI * 2 - Math.PI / 2;
    return {
      left: `${50 + Math.cos(angle) * 39}%`,
      top: `${50 + Math.sin(angle) * 39}%`
    };
  };

  const wheelLabel = computed(() => {
    const slot = actionBarSlots()[wheelSlot()];
    return slot?.skill?.name || slot?.item?.name || t("rpg.hotbar.choose");
  });

  mount(() => {
    if (typeof navigator === "undefined" || typeof requestAnimationFrame === "undefined") return;
    const clockTimer = setInterval(() => clock.set(Date.now()), 100);
    const gamepadConfig = engine.globalConfig.gamepadControls || {};
    const wheelButton = Number(gamepadConfig.hotbarWheelButton ?? 4);
    const cancelButton = Number(gamepadConfig.cancelButton ?? 1);
    const deadzone = Number(gamepadConfig.hotbarWheelDeadzone ?? 0.35);
    let animationFrame = 0;
    let wasPressed = false;
    let cancelled = false;
    let previousStopProcessingInput = false;

    const closeWheel = (activate) => {
      const slot = wheelSlot();
      wheelOpen.set(false);
      wheelSlot.set(-1);
      engine.stopProcessingInput = previousStopProcessingInput;
      if (activate && !cancelled && slot >= 0) selectSlot(slot);
      cancelled = false;
    };

    const poll = () => {
      const gamepad = Array.from(navigator.getGamepads?.() || [])
        .find((entry) => entry?.connected);
      const pressed = Boolean(gamepad?.buttons?.[wheelButton]?.pressed);
      if (pressed && !wasPressed) {
        previousStopProcessingInput = engine.stopProcessingInput;
        engine.stopProcessingInput = true;
        engine.interruptCurrentPlayerMovement?.();
        wheelOpen.set(true);
        wheelSlot.set(-1);
        cancelled = false;
      }
      if (pressed && gamepad) {
        if (gamepad.buttons?.[cancelButton]?.pressed) {
          cancelled = true;
          wheelSlot.set(-1);
        } else {
          const x = Number(gamepad.axes?.[0] || 0);
          const y = Number(gamepad.axes?.[1] || 0);
          const magnitude = Math.sqrt(x * x + y * y);
          if (magnitude < deadzone) {
            wheelSlot.set(-1);
          } else {
            const angle = (Math.atan2(y, x) + Math.PI / 2 + Math.PI * 2) % (Math.PI * 2);
            const sector = (Math.PI * 2) / 10;
            wheelSlot.set(Math.floor((angle + sector / 2) / sector) % 10);
          }
        }
      }
      if (!pressed && wasPressed && wheelOpen()) closeWheel(true);
      wasPressed = pressed;
      animationFrame = requestAnimationFrame(poll);
    };

    animationFrame = requestAnimationFrame(poll);
    return () => {
      clearInterval(clockTimer);
      cancelAnimationFrame(animationFrame);
      if (wheelOpen()) closeWheel(false);
    };
  });
</script>
