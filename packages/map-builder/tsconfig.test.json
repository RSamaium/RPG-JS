{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "rootDir": ".",
    "lib": ["ES2022", "DOM"],
    "resolveJsonModule": true,
    "types": ["vitest/globals", "node"],
    "paths": {
      "@rpgjs/map-builder": ["./src/index.ts"],
      "@rpgjs/map-builder/model": ["./src/model/index.ts"],
      "@rpgjs/map-builder/renderer": ["./src/renderer/index.ts"],
      "@rpgjs/map-builder/features": ["./src/features/index.ts"],
      "@rpgjs/map-builder/interaction": ["./src/interaction/index.ts"],
      "@rpgjs/map-builder/skins": ["./src/skins/index.ts"],
      "@rpgjs/map-builder/protocol": ["./src/protocol/index.ts"],
      "@rpgjs/map-builder/authority": ["./src/authority/index.ts"],
      "@rpgjs/map-builder/remote": ["./src/remote/index.ts"],
      "@rpgjs/map-builder/server": ["./src/server/index.ts"],
      "@rpgjs/map-builder/client": ["./src/client/index.ts"]
    }
  },
  "include": ["src/**/*.ts", "tests/**/*.ts"],
  "exclude": ["dist"]
}
