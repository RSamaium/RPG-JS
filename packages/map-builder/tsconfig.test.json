{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "rootDir": ".",
    "lib": ["ES2022", "DOM"],
    "types": ["vitest/globals", "node"],
    "paths": {
      "@rpgjs/map-builder": ["./src/index.ts"],
      "@rpgjs/map-builder/model": ["./src/model/index.ts"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["dist"]
}
