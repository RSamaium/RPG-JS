<DOMContainer width="100%" height="100%" controls={dialogControls}>
    <div class="rpg-ui-dialog-layer" data-closing={transition.closing() ? "true" : "false"}>
        <div
            class="rpg-ui-dialog-container"
            data-position={dialogPosition()}
            data-full-width={isFullWidth() ? "true" : "false"}
            data-has-face={hasFace() ? "true" : "false"}
        >
            <div class="rpg-ui-dialog rpg-anim-fade-in" click={stopEvent}>
                <button class="rpg-ui-close-button" type="button" aria-label={t("rpg.ui.close")} click={closeDialogFromPointer}>×</button>
                <div class="rpg-ui-dialog-body" data-has-choices={hasChoices() ? "true" : "false"}>
                   <div>
                        @if (speakerName()) {
                            <div class="rpg-ui-dialog-speaker">{speakerName()}</div>
                        }
                        <div class="rpg-ui-dialog-content" click={advance}>
                            @for (run of visibleRuns()) {
                                <span class={"rpg-ui-rich-" + run.kind}>{run.text}</span>
                            }
                        </div>
                        @if (hasChoices() || hasInput()) {
                          <div class="rpg-ui-dialog-actions">
                        @if (hasChoices() && ready()) {
                            <Navigation tabindex={selectedItem} controls={controls}>
                                <div class="rpg-ui-dialog-choices">
                                    @for ((choice,index) of dialogChoices()) {
                                        <div
                                            class="rpg-ui-dialog-choice"
                                            class={{active: selectedItem() === index}}
                                            tabindex={index}
                                            data-choice-index={index}
                                            click={selectChoice(index)}
                                        >{{ choice.text }}</div>
                                    }
                                </div>
                            </Navigation>
                        }
                        @if (hasInput() && ready()) {
                            <InputField
                                data={dialogInput}
                                layout="dialog"
                                showMessage={false}
                                submit={submitInput}
                                cancel={cancelInput}
                            />
                        }
                          </div>
                        }
                    </div>
                    @if (hasFace()) {
                        <div class="rpg-ui-dialog-face">
                            <DOMSprite
                                sheet={faceSheet(dialogFace())}
                                width={portraitSize}
                                height={portraitSize}
                                objectFit="contain"
                            />
                        </div>
                    }
                </div>
                @if (!isTyping() && (!ready() || (!hasInput() && !hasChoices()))) {
                    <button class="rpg-ui-dialog-continue" type="button" click={advance} aria-label={t("rpg.input.confirm")}>
                        <span aria-hidden="true"></span>
                    </button>
                }
            </div>
        </div>
    </div>
</DOMContainer>
    
<script>
    import { effect, signal, computed, createTabindexNavigator, mount } from "canvasengine";
    import { inject } from "../../../core/inject";
    import { RpgClientEngine } from "../../../RpgClientEngine";
    import { guiTransition, lockGuiInput, selectionSound } from "../lifecycle";
    import { parseRichText, paginateRichText, sliceRichText } from "../../../utils/richText";
    import { measureRichText, richTextLength, locateReadPosition } from "../../../utils/measuredRichText";
    import { getKeyboardControlBind } from "../../../services/actionInput";
    import InputField from "../input-field.ce";

    const engine = inject(RpgClientEngine);
    const { t } = engine.i18n();
    const currentPlayer = engine.scene.currentPlayer
    const keyboardControls = engine.globalConfig.keyboardControls;

    const releaseInput = lockGuiInput(engine);
    const transition = guiTransition();

    const selectedItem = signal(0)
    const ACTION_OPEN_GUARD_MS = 180;
    const openedAt = Date.now();

    const {
        data,
        onFinish,
        onInteraction,
        guiOpenId
    } = defineProps();

    const dialogData = computed(() => data() || {});
    const dialogChoices = computed(() => Array.isArray(dialogData().choices) ? dialogData().choices : []);
    const message = computed(() => dialogData().message);
    const speaker = computed(() => dialogData().speaker);
    const position = computed(() => dialogData().position);
    const typewriterEffect = computed(() => dialogData().typewriterEffect);
    const fullWidth = computed(() => dialogData().fullWidth || false);
    const dialogInput = computed(() => dialogData().input || null);
    const hasInput = computed(() => !!dialogInput());

    const resolveProp = (value) => typeof value === "function" ? value() : value;
    const normalizeOpenId = (value) => {
        const resolved = resolveProp(value);
        return typeof resolved === "string" && resolved.length > 0 ? resolved : undefined;
    };

    const speakerName = computed(() => {
        const value = resolveProp(speaker());
        return value ? String(value) : "";
    });

    const dialogPosition = computed(() => resolveProp(position()) || "bottom");
    const isFullWidth = computed(() => resolveProp(fullWidth) !== false);
    const dialogFace = computed(() => resolveProp(dialogData().face));
    const hasFace = computed(() => {
        const value = dialogFace();
        return !!(value && value.id);
    });

    const pagination = signal({ pages: [[]], index: 0, resume: 0 });
    const pageIndex = computed(() => pagination().index);
    const portraitSize = signal("180px");
    const pages = computed(() => pagination().pages);
    const currentRuns = computed(() => pages()[Math.min(pageIndex(), pages().length - 1)]);
    const visibleCount = signal(0);
    const visibleRuns = computed(() => sliceRichText(currentRuns(), visibleCount()));
    const fullMessage = signal("");
    const isTyping = signal(false);
    let typewriterTimer = null;
    let lastSoundAt = 0;
    let alive = true;
    let scheduleMeasure = () => {};
    effect(() => {
        const runs = parseRichText(String(resolveProp(message()) || ""));
        // Keep downstream layout reads outside dependency collection of this effect.
        queueMicrotask(() => {
            if (!alive) return;
            pagination.set({ pages: paginateRichText(runs, 320), index: 0, resume: 0 });
            scheduleMeasure();
        });
    });

    const startTypewriter = (text, resume = 0) => {
        if (typewriterTimer) clearInterval(typewriterTimer);
        visibleCount.set(resume);
        isTyping.set(false);
        if (!text) return;
        const characters = Array.from(text);
        let index = resume;
        if (index >= characters.length) return;
        isTyping.set(true);
        typewriterTimer = setInterval(() => {
            index += 1;
            visibleCount.set(index);
            if (/\S/.test(characters[index - 1]) && Date.now() - lastSoundAt >= 65) {
                engine.playUiSound("typewriter");
                lastSoundAt = Date.now();
            }
            if (index >= characters.length) {
                clearInterval(typewriterTimer);
                typewriterTimer = null;
                isTyping.set(false);
            }
        }, 20);
    };

    const finishTyping = () => {
        if (typewriterTimer) clearInterval(typewriterTimer);
        typewriterTimer = null;
        visibleCount.set(Array.from(fullMessage()).length);
        isTyping.set(false);
    };

    effect(() => {
        const text = currentRuns().map(run => run.text).join("");
        fullMessage.set(text);
        const useTypewriter = resolveProp(typewriterEffect()) !== false;
        if (!useTypewriter) {
            finishTyping();
            return;
        }
        startTypewriter(text, pagination().resume);
    });


    const hasChoices = computed(() => dialogChoices().length > 0);
    const ready = computed(() => !isTyping() && pageIndex() === pages().length - 1);
    selectionSound(() => selectedItem(), () => engine.playUiSound("navigate"));
    const nav = createTabindexNavigator(selectedItem, { count: () => dialogChoices().length }, 'wrap');

    function selectChoice(index) {
        return function() {
            selectedItem.set(index);
            onSelect(index);
        }
    }

    function _onFinish(value) {
        if (typewriterTimer) clearInterval(typewriterTimer);
        const openId = normalizeOpenId(guiOpenId);
        transition.finish(() => onFinish?.(value, openId));
    }

    const stopEvent = (event) => {
        event?.stopPropagation?.();
    };

    const closeDialog = () => {
        if (hasInput()) {
            cancelInput();
            return;
        }
        _onFinish();
    };

    const closeDialogFromPointer = (event) => {
        stopEvent(event);
        closeDialog();
    };

    const onSelect = (index) => {
        _onFinish(index);
    };

    const submitInput = (payload) => {
        onInteraction?.("submit", payload);
    };

    const cancelInput = () => {
        onInteraction?.("cancel");
    };

    const canAcceptAction = () => Date.now() - openedAt >= ACTION_OPEN_GUARD_MS;
    let lastActionAt = 0;
    function advance(event) {
        event?.stopPropagation?.();
        if (event?.repeat || !canAcceptAction() || transition.closing() || Date.now() - lastActionAt < 180) return;
        lastActionAt = Date.now();
        if (isTyping()) { finishTyping(); return; }
        if (pageIndex() < pages().length - 1) { pagination.set({ pages: pages(), index: pageIndex() + 1, resume: 0 }); return; }
        if (hasInput()) return;
        if (hasChoices()) { onSelect(selectedItem()); return; }
        _onFinish();
    }

    const controls = signal({
        up: {
            repeat: true,
            bind: keyboardControls.up,
            throttle: 150,
            keyDown() {
                if (!hasChoices() || !ready()) return;
                nav.next(-1);
            }
        },
        down: {
            repeat: true,
            bind: keyboardControls.down,
            throttle: 150,
            keyDown() {
                if (!hasChoices() || !ready()) return;
                nav.next(1);
            }
        },
        gamepad: {
            enabled: true
        }
    });
    
    const dialogControls = signal({
        action: {
            bind: getKeyboardControlBind(keyboardControls.action),
            keyDown: advance
        },
    })

    const faceSheet = (faceValue) => {
        if (!faceValue || !faceValue.id) {
            return undefined;
        }
        return {
            definition: engine.getSpriteSheet(faceValue.id),
            playing: faceValue.expression || "default",
        };
    }

    mount((element) => {
        // DOMSprite's contain transform needs concrete dimensions when the
        // typewriter or a viewport resize changes the dialogue body's height.
        const body = element.componentInstance?.element?.querySelector(".rpg-ui-dialog-body");
        const layer = element.componentInstance?.element?.querySelector(".rpg-ui-dialog-layer");
        const content = body?.querySelector(".rpg-ui-dialog-content");
        let frame = 0;
        let disposed = false;
        let measuredMessage = null;
        const reflow = () => {
            frame = 0;
            if (disposed || !content) return;
            const source = String(resolveProp(message()) || "");
            const column = content.parentElement;
            const speakerElement = column.querySelector(".rpg-ui-dialog-speaker");
            const speakerHeight = speakerElement ? speakerElement.offsetHeight + parseFloat(getComputedStyle(speakerElement).marginBottom || "0") : 0;
            const choiceTextBudget = hasChoices() ? Math.max(1, (column.clientHeight - speakerHeight) * .45) : undefined;
            const next = measureRichText(parseRichText(source), content, choiceTextBudget);
            if (!next) return;
            // An initial unmeasured fallback is not a page the player has read.
            const position = measuredMessage === source
                ? pages().slice(0, pageIndex()).reduce((sum, runs) => sum + richTextLength(runs), 0) + visibleCount() : 0;
            measuredMessage = source;
            if (JSON.stringify(next) === JSON.stringify(pages())) return;
            pagination.set({ pages: next, ...locateReadPosition(next, position) });
        };
        scheduleMeasure = () => { if (!frame && !disposed) frame = requestAnimationFrame(reflow); };
        const syncPortraitHeight = () => {
            if (body?.clientHeight) portraitSize.set(`${body.clientHeight}px`);
            scheduleMeasure();
        };
        const portraitObserver = typeof ResizeObserver !== "undefined" && body
            ? new ResizeObserver(syncPortraitHeight) : null;
        portraitObserver?.observe(body);
        if (content) portraitObserver?.observe(content);
        syncPortraitHeight();
        document.fonts?.ready.then(scheduleMeasure);
        document.fonts?.addEventListener("loadingdone", scheduleMeasure);
        const resizeViewport = () => {
            if (layer && window.visualViewport) layer.style.maxHeight = `${window.visualViewport.height}px`;
            scheduleMeasure();
        };
        resizeViewport();
        window.visualViewport?.addEventListener("resize", resizeViewport);
        // Enter is also a dialogue confirmation key. Do not intercept text inputs
        // or their validation, and suppress the button's synthetic Enter click.
        const confirmWithEnter = (event) => {
            if (event.key !== "Enter" || (hasInput() && ready()) || event.isComposing) return;
            event.preventDefault();
            event.stopImmediatePropagation();
            advance(event);
        };
        window.addEventListener("keydown", confirmWithEnter, true);
        return () => {
            disposed = true;
            alive = false;
            cancelAnimationFrame(frame);
            document.fonts?.removeEventListener("loadingdone", scheduleMeasure);
            window.visualViewport?.removeEventListener("resize", resizeViewport);
            portraitObserver?.disconnect();
            window.removeEventListener("keydown", confirmWithEnter, true);
            if (typewriterTimer) clearInterval(typewriterTimer);
            transition.dispose();
            releaseInput();
        }
  })
</script>
