<DOMContainer width="100%" height="100%" controls={controls}>
    <div class="rpg-ui-menu-panel rpg-ui-panel">
        <div class="rpg-ui-menu-panel-header">{t("rpg.menu.options")}</div>
        <div class="rpg-ui-menu-panel-body rpg-ui-options">
            <section class="rpg-ui-option-section">
                <div class="rpg-ui-eyebrow">{t("rpg.controls.title")}</div>
                <h2>{t("rpg.controls.movement")}</h2>
                <p>{t("rpg.controls.help")}</p>
                <div class="rpg-ui-keybindings">
                    @for (direction of configurableControls) {
                        <button type="button" class="rpg-ui-keybinding" class={{active: listening() === direction}} click={listen(direction)}>
                            <span>{t("rpg.controls." + direction)}</span>
                            <kbd>{listening() === direction ? "…" : keyLabel(preferences.bindings()[direction])}</kbd>
                        </button>
                    }
                </div>
                <p class="rpg-ui-option-feedback" role="status" aria-live="polite">{t(message())}</p>
                @if (listening()) {
                    <button type="button" class="rpg-ui-btn" click={cancelCapture}>{t("rpg.controls.cancel")}</button>
                }
                <button type="button" class="rpg-ui-btn" data-variant="secondary" data-focused={focusedRow() === "reset" ? "true" : "false"} click={resetBindings}>{t("rpg.controls.reset")}</button>
            </section>
            <section class="rpg-ui-option-section">
                <div class="rpg-ui-menu-panel-details-title">{t("rpg.audio.title")}</div>
                <label class="rpg-ui-language-option" data-focused={focusedRow() === "language" ? "true" : "false"}>
                    <span>{t("rpg.options.language")}</span>
                    <select class="rpg-ui-input" value={language} change={changeLanguage} aria-label={t("rpg.options.language")}>
                        <option value="auto">{t("rpg.options.language-auto")}</option>
                        @for (locale of locales) {
                            <option value={locale.id}>{locale.name}</option>
                        }
                    </select>
                </label>
                <div class="rpg-ui-menu-panel-details-desc">{t("rpg.audio.help")}</div>
                @for (channel of channels) {
                    <label class="rpg-ui-audio-option" data-focused={focusedRow() === channel.id ? "true" : "false"}>
                        <span>{t(channel.label)}</span>
                        <span>{percentages()[channel.id]}%</span>
                        <input
                            class="rpg-ui-input"
                            type="range"
                            min="0"
                            max="100"
                            step="1"
                            value={channel.value}
                            aria-label={t(channel.label)}
                            input={changeVolume(channel.id)}
                        />
                    </label>
                }
            </section>
        </div>
    </div>
</DOMContainer>

<script>
    import { signal, computed, effect, mount } from "canvasengine";
    import { configurableControls, movementPreferences } from "../../../services/movementPreferences";
    import { inject } from "../../../core/inject";
    import { getKeyboardControlBind } from "../../../services/actionInput";
    import { RpgClientEngine } from "../../../RpgClientEngine";
    import { menuGamepadControls } from "../../../services/gamepadControls";

    const engine = inject(RpgClientEngine);
    const { t } = engine.i18n();
    const preferences = movementPreferences(engine);
    const language = signal(engine.getLocalePreference());
    effect(() => { language.set(engine.getLocalePreference()); });
    const locales = engine.getAvailableLocales().map(id => {
        let name = id;
        try { name = new Intl.DisplayNames([id], { type: "language" }).of(id) || id; } catch { /* Non-BCP47 catalogue ids. */ }
        return { id, name: name.charAt(0).toUpperCase() + name.slice(1) };
    });
    const changeLanguage = (event) => {
        engine.setLocale(event.target.value);
        language.set(engine.getLocalePreference());
        engine.playUiSound("navigate");
    };
    const listening = signal(null);
    const message = signal("rpg.controls.saved");
    const keyLabel = (bind) => {
        if (Array.isArray(bind)) return bind.map(keyLabel).join(" / ");
        const special = ({ space: "space", 32: "space", enter: "enter", 13: "enter", escape: "escape", 27: "escape", backspace: "backspace", 8: "backspace" })[bind];
        if (special) return t("rpg.controls.key." + special);
        return ({ up: "↑", down: "↓", left: "←", right: "→", 38: "↑", 40: "↓", 37: "←", 39: "→" })[bind] || String(bind).toUpperCase();
    };
    const listen = (direction) => () => { listening.set(direction); message.set("rpg.controls.listen"); };
    const resetBindings = () => { listening.set(null); preferences.reset(); message.set("rpg.controls.saved"); };
    const cancelCapture = () => { listening.set(null); message.set("rpg.controls.saved"); };
    mount(() => {
        let captured = false;
        const keyDown = (event) => {
            if (captured && !listening()) { event.preventDefault(); event.stopImmediatePropagation(); return; }
            if (!listening()) return;
            event.preventDefault();
            event.stopImmediatePropagation();
            captured = true;
            if (event.repeat) return;
            if (event.key === "Escape" && listening() !== "escape") { cancelCapture(); return; }
            const key = event.key === " " ? "space" : event.key.toLowerCase().replace(/^arrow/, "");
            if (event.ctrlKey || event.altKey || event.metaKey || !preferences.assign(listening(), key)) {
                message.set("rpg.controls.conflict");
                return;
            }
            listening.set(null);
            message.set("rpg.controls.saved");
        };
        const keyUp = (event) => {
            if (!captured) return;
            event.preventDefault(); event.stopImmediatePropagation(); captured = false;
        };
        window.addEventListener("keydown", keyDown, true);
        window.addEventListener("keyup", keyUp, true);
        return () => { window.removeEventListener("keydown", keyDown, true); window.removeEventListener("keyup", keyUp, true); };
    });
    const channels = [
        { id: "master", label: "rpg.audio.master" },
        { id: "music", label: "rpg.audio.music" },
        { id: "sfx", label: "rpg.audio.sfx" },
        { id: "ui", label: "rpg.audio.ui" }
    ].map(channel => ({ ...channel, value: signal(String(Math.round(engine.getSoundVolume(channel.id) * 100))) }));
    const percentages = computed(() => Object.fromEntries(channels.map(channel => [channel.id, Number(channel.value())])));
    const setVolume = (channel, value) => {
        channels.find(entry => entry.id === channel).value.set(String(Math.round(value * 100)));
        engine.setSoundVolume(channel, value);
        if (channel === "ui" || channel === "master") engine.playUiSound("navigate");
    };
    const changeVolume = (channel) => (event) => setVolume(channel, Number(event?.target?.value ?? 100) / 100);

    // Gamepad / keyboard cursor over the options that are not text capture.
    const keyboardControls = engine.globalConfig.keyboardControls;
    const rows = ["language", ...channels.map(channel => channel.id), "reset"];
    const focusedRow = signal("language");
    const moveFocus = (delta) => {
        const index = rows.indexOf(focusedRow());
        focusedRow.set(rows[(index + delta + rows.length) % rows.length]);
        engine.playUiSound("navigate");
    };
    const adjustFocused = (delta) => {
        const row = focusedRow();
        if (row === "language") {
            const options = ["auto", ...locales.map(locale => locale.id)];
            const index = Math.max(0, options.indexOf(language()));
            changeLanguage({ target: { value: options[(index + delta + options.length) % options.length] } });
            return;
        }
        const channel = channels.find(entry => entry.id === row);
        if (!channel) return;
        const value = Math.max(0, Math.min(100, Number(channel.value()) + delta * 5));
        setVolume(channel.id, value / 100);
    };
    const controls = signal({
        up: { repeat: true, bind: keyboardControls.up, throttle: 150, keyDown() { if (!listening()) moveFocus(-1); } },
        down: { repeat: true, bind: keyboardControls.down, throttle: 150, keyDown() { if (!listening()) moveFocus(1); } },
        left: { repeat: true, bind: keyboardControls.left, throttle: 80, keyDown() { if (!listening()) adjustFocused(-1); } },
        right: { repeat: true, bind: keyboardControls.right, throttle: 80, keyDown() { if (!listening()) adjustFocused(1); } },
        action: {
            bind: getKeyboardControlBind(keyboardControls.action),
            keyDown() {
                if (!listening() && focusedRow() === "reset") resetBindings();
            }
        },
        gamepad: { ...menuGamepadControls, stepInterval: { default: 200, left: 80, right: 80 } }
    });

</script>

<style>
    .rpg-ui-audio-option {
        display: grid;
        grid-template-columns: minmax(7rem, 1fr) auto;
        align-items: center;
        gap: 0.35rem 1rem;
        margin-top: 0.9rem;
        color: var(--rpg-ui-text);
    }
    .rpg-ui-language-option[data-focused="true"],
    .rpg-ui-audio-option[data-focused="true"],
    .rpg-ui-btn[data-focused="true"] {
        outline: 2px solid var(--rpg-ui-accent);
        outline-offset: 3px;
    }
    .rpg-ui-audio-option .rpg-ui-input {
        grid-column: 1 / -1;
        padding: 0;
        accent-color: var(--rpg-ui-accent);
    }
</style>
