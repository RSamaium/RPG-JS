<DOMContainer width="100%" height="100%" controls={menuControls}>
    <div class="rpg-ui-main-menu rpg-anim-fade-in">
        <div class="rpg-ui-main-menu-layout">
            <div class="rpg-ui-main-menu-left rpg-ui-menu rpg-ui-panel">
                <div class="rpg-ui-menu-header">Main</div>
                <div class="rpg-ui-main-menu-list">
                    @for ((entry,index) of menuEntries()) {
                        <div
                            class="rpg-ui-menu-item"
                            data-disabled={isMenuDisabled(entry) ? "true" : "false"}
                            data-selected={selectedMenu() === index ? "true" : "false"}
                            tabindex={index}
                            click={selectMenu(index)}
                        >
                            <span class="rpg-ui-menu-row">
                                <span class="rpg-ui-menu-row-main">
                                    <span class="rpg-ui-menu-row-icon">{menuIcon(entry.id)}</span>
                                    <span class="rpg-ui-menu-row-label">{entry.label}</span>
                                </span>
                            </span>
                        </div>
                    }
                </div>
            </div>
            <div class="rpg-ui-main-menu-right">
                @if (view() === "menu") {
                    <div class="rpg-ui-main-menu-dashboard rpg-ui-panel">
                        <div class="rpg-ui-main-menu-title">Main Menu</div>

                        <div class="rpg-ui-main-menu-dashboard-grid">
                            <section class="rpg-ui-main-menu-card rpg-ui-main-menu-character-card">
                                <div class="rpg-ui-main-menu-section-title">Character Overview</div>
                                <div class="rpg-ui-main-menu-character">
                                    <div class="rpg-ui-main-menu-portrait">
                                        <div class="rpg-ui-main-menu-portrait-avatar">{playerInitial()}</div>
                                        <div class="rpg-ui-main-menu-portrait-level">{level()}</div>
                                    </div>
                                    <div class="rpg-ui-main-menu-character-info">
                                        <div class="rpg-ui-main-menu-character-name">{playerName()}</div>
                                        <div class="rpg-ui-main-menu-character-meta">Level {level()}</div>
                                        <div class="rpg-ui-main-menu-vitals">
                                            <div class="rpg-ui-main-menu-vital-row">
                                                <span>EXP {exp()} / {expForNextlevel()}</span>
                                                <div class="rpg-ui-main-menu-status-bar">
                                                    <div class="rpg-ui-main-menu-status-bar-fill" data-type="experience" style={{width: expPercent}}></div>
                                                </div>
                                            </div>
                                            <div class="rpg-ui-main-menu-status-bar">
                                                <span class="rpg-ui-main-menu-status-bar-label">HP {hp()}/{hpMax()}</span>
                                                <div class="rpg-ui-main-menu-status-bar-fill" data-type="health" style={{width: hpPercent}}></div>
                                            </div>
                                            <div class="rpg-ui-main-menu-status-bar">
                                                <span class="rpg-ui-main-menu-status-bar-label">SP {sp()}/{spMax()}</span>
                                                <div class="rpg-ui-main-menu-status-bar-fill" data-type="mana" style={{width: spPercent}}></div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="rpg-ui-main-menu-currency-grid">
                                    <div class="rpg-ui-main-menu-currency">
                                        <span class="rpg-ui-main-menu-currency-icon">G</span>
                                        <span>
                                            <span class="rpg-ui-main-menu-currency-label">Gold</span>
                                            <strong>{gold()}</strong>
                                        </span>
                                    </div>
                                    <div class="rpg-ui-main-menu-currency">
                                        <span class="rpg-ui-main-menu-currency-icon">LV</span>
                                        <span>
                                            <span class="rpg-ui-main-menu-currency-label">Level</span>
                                            <strong>{level()}</strong>
                                        </span>
                                    </div>
                                </div>
                            </section>

                            <section class="rpg-ui-main-menu-card rpg-ui-main-menu-stats-card">
                                <div class="rpg-ui-main-menu-section-title">Stats</div>
                                <div class="rpg-ui-main-menu-params">
                                    @for ((param,index) of paramsList) {
                                        <div class="rpg-ui-main-menu-param">
                                            <span>{param.label}</span>
                                            <span>{param.value}</span>
                                        </div>
                                    }
                                </div>
                            </section>

                            <section class="rpg-ui-main-menu-card rpg-ui-main-menu-equipment-card">
                                <div class="rpg-ui-main-menu-section-title">Equipment</div>
                                <div class="rpg-ui-main-menu-equipment-grid">
                                    @for ((slot,index) of equipmentPreview) {
                                        <div class="rpg-ui-main-menu-equipment-slot" data-empty={slot.empty ? "true" : "false"}>
                                            @if (slot.icon) {
                                                <DOMSprite
                                                    sheet={iconSheet(slot.icon)}
                                                    playing="default"
                                                    width="32px"
                                                    height="32px"
                                                    objectFit="contain"
                                                />
                                            }
                                            @if (!slot.icon) {
                                                <span>{slot.label}</span>
                                            }
                                        </div>
                                    }
                                </div>
                            </section>

                            <section class="rpg-ui-main-menu-card rpg-ui-main-menu-activity-card">
                                <div class="rpg-ui-main-menu-section-title">Recent Activity</div>
                                <div class="rpg-ui-main-menu-activity-list">
                                    @for ((entry,index) of activityRows) {
                                        <div class="rpg-ui-main-menu-activity-row">
                                            <span>
                                                <strong>{entry.title}</strong>
                                                <small>{entry.description}</small>
                                            </span>
                                            <span class="rpg-ui-main-menu-activity-meta">{entry.meta}</span>
                                        </div>
                                    }
                                </div>
                            </section>
                        </div>
                    </div>
                }
                @if (view() === "items") {
                    <ItemsMenu data={data} onInteraction={onInteraction} onBack={goBack} />
                }
                @if (view() === "skills") {
                    <SkillsMenu data={data} onBack={goBack} />
                }
                @if (view() === "equip") {
                    <EquipMenu data={data} onInteraction={onInteraction} onBack={goBack} />
                }
                @if (view() === "options") {
                    <OptionsMenu onBack={goBack} />
                }
                @if (view() === "exit") {
                    <ExitMenu onConfirm={confirmExit} onBack={goBack} />
                }
            </div>
        </div>
        @if (saveOverlay) {
            <div class="rpg-ui-main-menu-overlay">
                <div class="rpg-ui-main-menu-overlay-backdrop"></div>
                <div class="rpg-ui-main-menu-overlay-content">
                    <SaveLoadComponent
                        data={saveLoadData}
                        onFinish={closeSaveOverlay}
                    />
                </div>
            </div>
        }
    </div>
</DOMContainer>

<script>
    import { signal, computed, effect, mount } from "canvasengine";
    import { inject } from "../../../core/inject";
    import { RpgClientEngine } from "../../../RpgClientEngine";
    import SaveLoadComponent from "../save-load.ce";
    import ItemsMenu from "./items-menu.ce";
    import SkillsMenu from "./skills-menu.ce";
    import EquipMenu from "./equip-menu.ce";
    import OptionsMenu from "./options-menu.ce";
    import ExitMenu from "./exit-menu.ce";
    import { getEntityProp } from "../../../utils/getEntityProp";
    import { delay } from "@rpgjs/common";
    import { getKeyboardControlBind } from "../../../services/actionInput";

    const engine = inject(RpgClientEngine);
    const currentPlayer = engine.scene.currentPlayer;
    const keyboardControls = engine.globalConfig.keyboardControls;

    const { data, onFinish, onInteraction } = defineProps();
    const { menus, items, skills, equips, saveLoad } = data();

    const defaultMenus = [
        { id: "items", label: "Items" },
        { id: "skills", label: "Skills" },
        { id: "equip", label: "Equip" },
        { id: "options", label: "Options" },
        { id: "save", label: "Save" },
        { id: "exit", label: "Exit" }
    ];

    const menuEntries = computed(() => {
        if (menus && Array.isArray(menus) && menus.length) return menus;
        return defaultMenus;
    });

    const resolveProp = (value) => typeof value === "function" ? value() : value;
    const saveLoadData = computed(() => resolveProp(saveLoad) || {});
    const saveLoadMode = computed(() => saveLoadData().mode || "load");
    const saveLoadSlots = computed(() => saveLoadData().slots || []);
    const saveLoadCanSave = computed(() => saveLoadData().canSave !== false);

    const isMenuDisabled = (entry) => {
        if (!entry) return true;
        if (entry.disabled) return true;
        if (entry.enabled === false) return true;
        if (entry.id === "save" && !saveLoadCanSave()) return true;
        return false;
    };

    const selectedMenu = signal(0);
    const view = signal("menu");
    const saveOverlay = signal(false);

    const selectableIndexes = computed(() => {
        const entries = menuEntries();
        return entries
            .map((entry, index) => (isMenuDisabled(entry) ? null : index))
            .filter((value) => value !== null);
    });

    effect(() => {
        const available = selectableIndexes();
        if (!available.length) return;
        const current = selectedMenu();
        if (!available.includes(current)) {
            selectedMenu.set(available[0]);
        }
    });

    const moveMenu = (delta) => {
        const available = selectableIndexes();
        if (!available.length) return;
        const current = selectedMenu();
        const currentIndex = Math.max(0, available.indexOf(current));
        const nextIndex = (currentIndex + delta + available.length) % available.length;
        selectedMenu.set(available[nextIndex]);
    };

    function selectMenu(index) {
        return function() {
            selectedMenu.set(index);
            openMenu();
        }
    }

    const openMenu = () => {
        const entry = menuEntries()[selectedMenu()];
        if (!entry || isMenuDisabled(entry)) return;
        if (entry.id === "save") {
            saveOverlay.set(true);
            return;
        }
        if (entry.id === "exit") {
            view.set("exit");
            return;
        }
        view.set(entry.id);
    };

    const goBack = () => {
        delay(() => {
            view.set("menu");
        });
    };

    const closeSaveOverlay = () => {
        delay(() => {
            saveOverlay.set(false);
            view.set("menu");
        });
    };

    const confirmExit = () => {
        if (onInteraction) onInteraction("exit");
    };

    const menuIcon = (id) => {
        const icons = {
            items: "B",
            skills: "S",
            equip: "E",
            options: "O",
            save: "V",
            exit: "X"
        };
        return icons[id] || "M";
    };

    const hp = getEntityProp(currentPlayer, "hp");
    const hpMax = getEntityProp(currentPlayer, "params.maxHp");
    const sp = getEntityProp(currentPlayer, "sp");
    const spMax = getEntityProp(currentPlayer, "params.maxSp");
    const level = getEntityProp(currentPlayer, "level");
    const exp = getEntityProp(currentPlayer, "exp");
    const gold = getEntityProp(currentPlayer, "gold");
    const name = getEntityProp(currentPlayer, "name");
    const playerName = computed(() => name() || "Adventurer");
    const playerInitial = computed(() => {
        const value = playerName();
        return String(value || "A").trim().slice(0, 1).toUpperCase() || "A";
    });
    const expForNextlevel = computed(() => data().expForNextlevel || 0);
    const hpPercent = computed(() => {
        const max = hpMax() || 1;
        return `${Math.max(0, Math.min(100, (hp() / max) * 100))}%`;
    });
    const spPercent = computed(() => {
        const max = spMax() || 1;
        return `${Math.max(0, Math.min(100, (sp() / max) * 100))}%`;
    });
    const expPercent = computed(() => {
        const max = expForNextlevel() || 1;
        return `${Math.max(0, Math.min(100, (exp() / max) * 100))}%`;
    });

    const safeItems = computed(() => {
        const value = resolveProp(data().items);
        return Array.isArray(value) ? value : [];
    });
    const safeEquips = computed(() => {
        const value = resolveProp(data().equips);
        if (Array.isArray(value)) return value;
        return safeItems().filter((item) => item?.type === "weapon" || item?.type === "armor");
    });
    const safeSkills = computed(() => {
        const value = resolveProp(data().skills);
        return Array.isArray(value) ? value : [];
    });
    const iconSheet = (iconId) => ({
        definition: engine.getSpriteSheet(iconId)
    });
    const equipmentPreview = computed(() => {
        const slots = safeEquips().slice(0, 8).map((item) => ({
            empty: false,
            icon: item.icon,
            label: (item.name || item.type || "?").slice(0, 1).toUpperCase()
        }));
        while (slots.length < 8) {
            slots.push({ empty: true, icon: null, label: "" });
        }
        return slots;
    });
    const activityRows = computed(() => {
        const rows = [];
        safeEquips().slice(0, 2).forEach((item) => {
            rows.push({
                title: item.name || "Equipment",
                description: item.equipped ? "Equipped" : (item.description || "Equipment available"),
                meta: item.type || "gear"
            });
        });
        safeSkills().slice(0, 2).forEach((skill) => {
            rows.push({
                title: skill.name || "Skill",
                description: skill.description || "Learned skill",
                meta: `SP ${skill.spCost ?? 0}`
            });
        });
        safeItems().slice(0, 2).forEach((item) => {
            rows.push({
                title: item.name || "Item",
                description: item.description || "Inventory item",
                meta: `x${item.quantity ?? 1}`
            });
        });
        if (!rows.length) {
            rows.push({
                title: "No activity",
                description: "Inventory, skills and equipment will appear here.",
                meta: "-"
            });
        }
        return rows.slice(0, 3);
    });

    const paramsList = computed(() => {
        const stats = data().playerStats || {};
        return [
            { label: "ATK", value: stats.atk ?? 0 },
            { label: "PDEF", value: stats.pdef ?? 0 },
            { label: "SDEF", value: stats.sdef ?? 0 },
            { label: "STR", value: stats.str ?? 0 },
            { label: "DEX", value: stats.dex ?? 0 },
            { label: "INT", value: stats.int ?? 0 },
            { label: "AGI", value: stats.agi ?? 0 },
            { label: "HP MAX", value: stats.maxHp ?? hpMax() ?? 0 },
            { label: "SP MAX", value: stats.maxSp ?? spMax() ?? 0 }
        ]
    }

    const menuControls = signal({
        up: {
            repeat: true,
            bind: keyboardControls.up,
            throttle: 150,
            keyDown() {
                if (saveOverlay()) return;
                if (view() !== "menu") return;
                moveMenu(-1);
            }
        },
        down: {
            repeat: true,
            bind: keyboardControls.down,
            throttle: 150,
            keyDown() {
                if (saveOverlay()) return;
                if (view() !== "menu") return;
                moveMenu(1);
            }
        },
        action: {
            bind: getKeyboardControlBind(keyboardControls.action),
            keyDown() {
                if (saveOverlay()) return;
                if (view() !== "menu") return;
                openMenu();
            }
        },
        escape: {
            bind: keyboardControls.escape,
            keyDown() {
                if (saveOverlay()) return;
                if (view() !== "menu") {
                    goBack();
                    return;
                }
                onFinish()
            }
        },
        gamepad: {
            enabled: true
        }
    });

    mount((element) => {
        engine.gamePause.set(true);
        return () => {
            delay(() => {
                engine.stopProcessingInput = false;
                engine.gamePause.set(false);
            });
        }
    });
</script>
