<DOMContainer width="100%" height="100%" class="rpg-hotbar-root" controls={controls}>
  <div class="rpg-hotbar-dock">
    @if (visibleSlots().length) {
    <div
      class="rpg-ui-hotbar rpg-hotbar-plate"
      style={{ "--rpg-ui-hotbar-slots": Math.max(1, visibleSlots().length) }}
    >
      <div class="rpg-ui-hotbar-track">
        @for ((slot, visibleIndex) of visibleSlots()) {
          <button
            type="button"
            class="rpg-ui-hotbar-slot rpg-hotbar-slot"
            data-selected={selectedSlot() === slot.index ? "true" : "false"}
            data-disabled={slot.usable === false ? "true" : "false"}
            attrs={{ "aria-label": slotAriaLabel(slot, slot.index), tabindex: slot.index }}
            click={selectSlot(slot.index)}
          >
            <span class="rpg-ui-hotbar-key">{slotLabels[slot.index]}</span>
            @if (slot.icon) {
              <DOMSprite sheet={iconSheet(slot.icon)} width="52px" height="52px" scale={2} objectFit="contain" />
            } @else if (slot.name) {
              @if (slot.type === "skill") {
                <span class="rpg-hotbar-fallback">✦</span>
              }
              <span class="rpg-ui-hotbar-text">{slot.name}</span>
            }
            @if (slot.type === "skill" && (slot.spCost ?? 0) > 0) {
              <span class="rpg-hotbar-cost">{slot.spCost} SP</span>
            }
            @if (slot.type === "item" && slot.quantity !== undefined) {
              <span class="rpg-ui-hotbar-count">x{slot.quantity}</span>
            }
            @if (cooldownLabel(slot)) {
              <span class="rpg-hotbar-cooldown">{cooldownLabel(slot)}</span>
            }
          </button>
        }
      </div>
    </div>
    }
  </div>

  @if (wheelOpen()) {
    <div class="rpg-hotbar-wheel-backdrop">
      <div class="rpg-hotbar-wheel" role="menu" aria-label={t("rpg.hotbar.radial")}>
        <div class="rpg-hotbar-wheel-center">
          <span>{selectedWheelLabel()}</span>
          <small>{t("rpg.hotbar.release")}</small>
        </div>
        @for ((slot, index) of slots()) {
          <div
            class="rpg-hotbar-wheel-slot"
            data-selected={wheelSlot() === index ? "true" : "false"}
            data-disabled={slot.usable === false ? "true" : "false"}
            data-empty={slot.type === "empty" ? "true" : "false"}
            style={wheelSlotStyle(index)}
          >
            <span class="rpg-hotbar-wheel-key">{slotLabels[index]}</span>
            @if (slot.icon) {
              <DOMSprite sheet={iconSheet(slot.icon)} width="54px" height="54px" scale={2} objectFit="contain" />
            } @else {
              <span>{slot.name || t("rpg.menu.empty")}</span>
            }
          </div>
        }
      </div>
    </div>
  }
</DOMContainer>

<style>
  .rpg-hotbar-root {
    pointer-events: none;
  }

  .rpg-hotbar-dock {
    position: absolute;
    left: 12px;
    right: 12px;
    bottom: 12px;
    display: flex;
    justify-content: center;
    pointer-events: auto;
  }

  .rpg-hotbar-plate {
    width: auto;
    max-width: 100%;
    --rpg-ui-hotbar-size: clamp(38px, 8vw, 52px);
  }

  .rpg-hotbar-slot {
    appearance: none;
    color: inherit;
    font: inherit;
    padding: 0;
    width: clamp(48px, 7vw, 62px);
  }

  .rpg-hotbar-fallback {
    font-size: 1.3rem;
    color: var(--rpg-ui-accent);
    text-shadow: 0 0 12px color-mix(in srgb, var(--rpg-ui-accent), transparent 25%);
  }

  .rpg-hotbar-cost {
    position: absolute;
    right: 3px;
    bottom: 2px;
    z-index: 3;
    padding: 1px 3px;
    border-radius: 4px;
    background: rgb(4 10 20 / 82%);
    color: #86caff;
    font-size: 8px;
    font-weight: 900;
    line-height: 1;
  }

  .rpg-hotbar-cooldown {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    border-radius: inherit;
    background: rgb(5 10 18 / 68%);
    color: white;
    font-weight: 800;
    font-size: 0.82rem;
    text-shadow: 0 1px 3px rgb(0 0 0 / 85%);
  }

  .rpg-hotbar-wheel-backdrop {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    background: rgb(2 7 14 / 38%);
    pointer-events: none;
  }

  .rpg-hotbar-wheel {
    position: relative;
    width: min(72vw, 430px);
    aspect-ratio: 1;
    border-radius: 50%;
    background:
      radial-gradient(circle, rgb(17 28 43 / 96%) 0 23%, transparent 24%),
      radial-gradient(circle, rgb(9 18 31 / 88%) 0 64%, rgb(3 8 16 / 92%) 65% 100%);
    border: 3px solid var(--rpg-ui-border-light);
    box-shadow: 0 20px 65px rgb(0 0 0 / 58%);
  }

  .rpg-hotbar-wheel-center {
    position: absolute;
    inset: 38%;
    display: grid;
    place-items: center;
    align-content: center;
    text-align: center;
    color: white;
    font-weight: 800;
    text-shadow: 0 2px 4px black;
  }

  .rpg-hotbar-wheel-center small {
    margin-top: 4px;
    color: var(--rpg-ui-text-muted);
    font-size: 0.65rem;
    font-weight: 600;
  }

  .rpg-hotbar-wheel-slot {
    position: absolute;
    width: 72px;
    height: 72px;
    translate: -50% -50%;
    display: grid;
    place-items: center;
    overflow: hidden;
    border: 2px solid var(--rpg-ui-border-dark);
    border-radius: 16px;
    background: var(--rpg-ui-surface);
    color: var(--rpg-ui-text);
    font-size: 0.68rem;
    text-align: center;
    transition: scale 90ms ease, border-color 90ms ease, filter 90ms ease;
  }

  .rpg-hotbar-wheel-slot[data-selected="true"] {
    z-index: 2;
    scale: 1.18;
    border-color: var(--rpg-ui-accent);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--rpg-ui-accent), transparent 58%);
  }

  .rpg-hotbar-wheel-slot[data-disabled="true"],
  .rpg-hotbar-wheel-slot[data-empty="true"] {
    filter: grayscale(1);
    opacity: 0.52;
  }

  .rpg-hotbar-wheel-key {
    position: absolute;
    left: 5px;
    top: 3px;
    z-index: 3;
    font-weight: 900;
    color: var(--rpg-ui-accent);
  }
</style>

<script>
  import { computed, mount, signal } from "canvasengine";
  import { inject } from "../../core/inject";
  import { RpgClientEngine } from "../../RpgClientEngine";

  const { data, onInteraction } = defineProps();
  const engine = inject(RpgClientEngine);
  const { t } = engine.i18n();
  const slotLabels = ["1", "2", "3", "4", "5", "6", "7", "8", "9", "0"];
  const slotControlNames = [
    "hotbar1",
    "hotbar2",
    "hotbar3",
    "hotbar4",
    "hotbar5",
    "hotbar6",
    "hotbar7",
    "hotbar8",
    "hotbar9",
    "hotbar0"
  ];
  const selectedSlot = signal(-1);
  const wheelOpen = signal(false);
  const wheelSlot = signal(-1);
  const clock = signal(Date.now());
  const normalizeBind = (bind) =>
    typeof bind === "string" && /^[0-9]$/.test(bind) ? `n${bind}` : bind;

  const resolveProp = (value) => typeof value === "function" ? value() : value;
  const hotbarData = computed(() => resolveProp(data) || {});
  const slots = computed(() => {
    const source = Array.isArray(hotbarData().slots) ? hotbarData().slots : [];
    return Array.from({ length: 10 }, (_, index) => source[index] || {
      index,
      type: "empty",
      entry: null,
      usable: false
    });
  });
  const visibleSlots = computed(() =>
    slots().filter((slot) => slot.type !== "empty")
  );

  const iconSheet = (iconId) => ({
    definition: engine.getSpriteSheet(iconId),
    playing: "default"
  });

  const cooldownLabel = (slot) => {
    const remaining = Number(slot?.readyAt ?? 0) - clock();
    return remaining > 0 ? `${Math.max(1, Math.ceil(remaining / 1000))}s` : "";
  };

  const slotAriaLabel = (slot, index) =>
    `${t("rpg.hotbar.slot", { index: slotLabels[index] })}: ${slot.name || t("rpg.menu.empty")}`;

  const useSlot = (index) => {
    const slot = slots()[index];
    if (!slot || slot.type === "empty" || slot.usable === false) return;
    selectedSlot.set(index);
    onInteraction?.("useSlot", { slot: index });
  };

  const selectSlot = (index) => () => useSlot(index);

  const wheelSlotStyle = (index) => {
    const angle = (index / 10) * Math.PI * 2 - Math.PI / 2;
    return {
      left: `${50 + Math.cos(angle) * 39}%`,
      top: `${50 + Math.sin(angle) * 39}%`
    };
  };

  const selectedWheelLabel = computed(() => {
    const slot = slots()[wheelSlot()];
    return slot?.name || (wheelSlot() >= 0 ? t("rpg.menu.empty") : t("rpg.hotbar.choose"));
  });

  const keyboardControls = engine.globalConfig.keyboardControls || {};
  const controlsConfig = {};
  slotControlNames.forEach((name, index) => {
    controlsConfig[`hotbar-slot-${index}`] = {
      bind: normalizeBind(keyboardControls[name] || `n${slotLabels[index]}`),
      keyDown() {
        if (!wheelOpen()) useSlot(index);
      }
    };
  });
  controlsConfig.gamepad = { enabled: false };
  const controls = signal(controlsConfig);

  mount(() => {
    if (typeof navigator === "undefined" || typeof requestAnimationFrame === "undefined") return;
    const clockTimer = setInterval(() => clock.set(Date.now()), 100);
    const gamepadConfig = engine.globalConfig.gamepadControls || {};
    const wheelButton = Number(gamepadConfig.hotbarWheelButton ?? 4);
    const cancelButton = Number(gamepadConfig.cancelButton ?? 1);
    const deadzone = Number(gamepadConfig.hotbarWheelDeadzone ?? 0.35);
    let animationFrame = 0;
    let wasPressed = false;
    let cancelled = false;
    let previousStopProcessingInput = false;

    const closeWheel = (activate) => {
      const slot = wheelSlot();
      wheelOpen.set(false);
      wheelSlot.set(-1);
      engine.stopProcessingInput = previousStopProcessingInput;
      if (activate && !cancelled && slot >= 0) useSlot(slot);
      cancelled = false;
    };

    const poll = () => {
      const gamepad = Array.from(navigator.getGamepads?.() || [])
        .find((entry) => entry?.connected);
      const pressed = Boolean(gamepad?.buttons?.[wheelButton]?.pressed);
      if (pressed && !wasPressed) {
        previousStopProcessingInput = engine.stopProcessingInput;
        engine.stopProcessingInput = true;
        engine.interruptCurrentPlayerMovement?.();
        wheelOpen.set(true);
        wheelSlot.set(-1);
        cancelled = false;
      }

      if (pressed && gamepad) {
        if (gamepad.buttons?.[cancelButton]?.pressed) {
          cancelled = true;
          wheelSlot.set(-1);
        } else {
          const x = Number(gamepad.axes?.[0] || 0);
          const y = Number(gamepad.axes?.[1] || 0);
          const magnitude = Math.sqrt(x * x + y * y);
          if (magnitude < deadzone) {
            wheelSlot.set(-1);
          } else {
            const angle = (Math.atan2(y, x) + Math.PI / 2 + Math.PI * 2) % (Math.PI * 2);
            const sector = (Math.PI * 2) / 10;
            wheelSlot.set(Math.floor((angle + sector / 2) / sector) % 10);
          }
        }
      }

      if (!pressed && wasPressed && wheelOpen()) closeWheel(true);
      wasPressed = pressed;
      animationFrame = requestAnimationFrame(poll);
    };

    animationFrame = requestAnimationFrame(poll);
    return () => {
      clearInterval(clockTimer);
      cancelAnimationFrame(animationFrame);
      if (wheelOpen()) closeWheel(false);
    };
  });
</script>
