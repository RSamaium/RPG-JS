{
  "name": "@rpgjs/calendar",
  "repository": "github:RSamaium/RPG-JS",
  "version": "5.0.0",
  "description": "Official generic calendar module for RPGJS: dates, recurring events and a calendar window",
  "main": "dist/client/index.js",
  "types": "dist/client/client-index.d.ts",
  "exports": {
    ".": {
      "browser": "./dist/client/index.js",
      "node": "./dist/server/index.js",
      "import": "./dist/client/index.js",
      "types": "./dist/client/client-index.d.ts"
    },
    "./client": {
      "import": "./dist/client/index.js",
      "types": "./dist/client/client-index.d.ts"
    },
    "./server": {
      "import": "./dist/server/index.js",
      "types": "./dist/server/server-index.d.ts"
    }
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@rpgjs/client": "workspace:^",
    "@rpgjs/common": "workspace:^",
    "@rpgjs/server": "workspace:^",
    "@rpgjs/vite": "workspace:^",
    "canvasengine": "^2.4.0"
  },
  "devDependencies": {
    "@canvasengine/compiler": "2.4.0",
    "vite": "^8.0.16",
    "vite-plugin-dts": "^5.0.2",
    "vitest": "^4.1.9"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "type": "module"
}
