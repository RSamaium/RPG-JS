  },
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "test": "vitest run"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "peerDependencies": {
    "@canvasengine/presets": "^2.5.0",
    "canvasengine": "^2.5.1",
    "pixi-filters": "^6.1.5",
    "pixi.js": "^8.9.2"
  },
  "devDependencies": {
    "vite": "^8.0.16",
    "vite-plugin-dts": "^5.0.2"
  }
}
