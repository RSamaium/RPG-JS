{
  "name": "@rpgjs/battle-kit",
  "repository": "github:RSamaium/RPG-JS",
  "version": "5.2.0",
  "description": "Presentation pieces shared by the RPGJS battle systems: effect presets, screen impacts, floating numbers, element colours and a presentation clock",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./pure": {
      "import": "./dist/pure.js",
      "types": "./dist/pure.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
