<Container
  pixiChildren={terrainPixiChildren}
  onBeforeDestroy={destroyTerrainRenderer}
/>

<script>
import { effect, tick } from "canvasengine"
import { RpgClientEngine, inject } from "@rpgjs/client"
import { Container as PixiContainer } from "pixi.js"
import { StudioTerrainChunkRenderer } from "../terrain-renderer/terrain-chunk-renderer"
import { createViewportCullKey, getPixiLocalViewportBounds } from "../viewport-culling"
import { markStudioMapReady } from "../../studio-map-readiness"

const { data, debugCollisions, splitWallForeground } = defineProps({
  debugCollisions: {
    type: Boolean,
    default: false
  },
  splitWallForeground: {
    type: Boolean,
    default: false
  }
})

// The container is given no width or height: a Pixi container with a width is scaled so that what it holds is that wide,
// and the chunks held change as the camera moves (only the ones in view are drawn), so the terrain was stretched.
const TERRAIN_CULL_MARGIN = 384
const TERRAIN_CULL_GRID_SIZE = 128
const readValue = (value) => typeof value === "function" ? value() : value
const engine = inject(RpgClientEngine)
const terrainWorld = new PixiContainer()
terrainWorld.sortableChildren = true
terrainWorld.roundPixels = true
const terrainPixiChildren = [terrainWorld]
let terrainRenderer = new StudioTerrainChunkRenderer(terrainWorld)
let renderSerial = 0
let lastCullKey = ""
let readyMapData = null

const renderTerrain = async (viewportBounds = getPixiLocalViewportBounds(engine, terrainWorld)) => {
  const mapData = readValue(data)
  if (!mapData) return
  const currentSerial = ++renderSerial
  await terrainRenderer.renderMap(mapData, {
    debugCollisions: readValue(debugCollisions) === true,
    splitWallForeground: readValue(splitWallForeground) === true,
    streamUpdate: mapData.terrainRenderData?.streamUpdate,
    viewportBounds,
    viewportMargin: TERRAIN_CULL_MARGIN
  })
  if (currentSerial !== renderSerial) {
    return
  }
  terrainRenderer.updateChunkVisibility(viewportBounds, TERRAIN_CULL_MARGIN)
  if (readyMapData !== mapData) {
    await waitForPresentedFrame()
    if (currentSerial !== renderSerial) return
    readyMapData = mapData
    markStudioMapReady()
  }
}

effect(() => {
  readValue(data)
  readValue(debugCollisions)
  readValue(splitWallForeground)
  void renderTerrain()
})

tick(({ deltaTime }) => {
  terrainRenderer.update(deltaTime)
  updateTerrainCulling()
})

function updateTerrainCulling() {
  const bounds = getPixiLocalViewportBounds(engine, terrainWorld)
  if (!bounds) {
    if (lastCullKey) {
      lastCullKey = ""
      terrainRenderer.updateChunkVisibility(null)
    }
    return
  }

  const cullKey = createViewportCullKey(bounds, TERRAIN_CULL_GRID_SIZE)

  if (cullKey === lastCullKey) {
    return
  }

  lastCullKey = cullKey
  terrainRenderer.updateChunkVisibility(bounds, TERRAIN_CULL_MARGIN)
  void renderTerrain(bounds)
}

function destroyTerrainRenderer() {
  renderSerial += 1
  lastCullKey = ""
  readyMapData = null
  terrainRenderer.destroy()
}

async function waitForPresentedFrame() {
  await new Promise((resolve) => requestAnimationFrame(resolve))
  await new Promise((resolve) => requestAnimationFrame(resolve))
}
</script>
