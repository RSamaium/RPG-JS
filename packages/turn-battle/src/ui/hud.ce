<DOMContainer width="100%" height="100%">
  <div class={['tb-root', 'rpg-ui-theme-default', 'tb-phase-' + phase(), { 'tb-reduced': reduced() }]}>
    @if (phase() !== 'closed') {
      <div class={['tb-timeline', { 'tb-preview': previewing() }]}>
        <div class="tb-timeline-rail"></div>
        <div class="tb-timeline-chips">
          @for (chip of order(); track chip.key) {
            <div class={['tb-chip', 'tb-' + chip.side, { 'tb-current': chip.current, 'tb-landing': chip.landing }]} title={chip.name}>
              <div class="tb-chip-face" style={faceStyle(chip.battler, chip.current ? 50 : 38)}></div>
            </div>
          }
        </div>
      </div>
      <div class="tb-options">
        @if (spectating()) {
          <span class="tb-pill tb-spectator-badge">👁 {{ t('tb.spectator') }}</span>
          <button class="rpg-ui-btn tb-pill" data-variant="secondary" data-size="small" click={leaveWatching}>{{ t('tb.leave') }} ✕</button>
        }
        @if (pvp() && !spectating() && phase() !== 'result') {
          <button class={['rpg-ui-btn', 'tb-pill', 'tb-surrender', { 'tb-armed': surrenderArmed(), 'tb-done': surrendered() }]} data-variant="ghost" data-size="small" click={surrender} title={t('tb.surrenderHint')}>⚑ {{ surrenderLabel() }}</button>
        }
        @if (!spectating() && audience() > 0) {
          <span class="tb-pill tb-audience" title={t('tb.audience')}>👁 {{ audience() }}</span>
        }
        <button class="rpg-ui-btn tb-pill" data-variant="ghost" data-size="small" click={toggleMuted} title={t('tb.sound')}>{{ muted() ? '🔇' : '🔊' }}</button>
        <button class="rpg-ui-btn tb-pill" data-variant="ghost" data-size="small" click={cycleSpeed} title={t('tb.speed')}>▸▸ ×{{ speed() }}</button>
      </div>
    }

    @if (banner()) {
      <div class={['tb-banner', 'tb-' + banner()?.side]}><span>{{ banner()?.text }}</span></div>
    }

    @if (phase() === 'command' || phase() === 'target') {
      <section class={['rpg-ui-panel', 'tb-menu', { 'tb-dim': phase() === 'target' }]}>
        <header>
          <span class="rpg-ui-eyebrow tb-menu-title">{{ menuTitle() }}</span>
          @if (countdown() !== null) {
            <span class={['tb-countdown', { 'tb-urgent': countdown() <= 5 }]}>{{ countdown() }}</span>
          }
          @if (menuLevel() !== 'root') {
            <button class="tb-back" click={back}>✕</button>
          }
        </header>
        <div class="tb-menu-list">
          @for (entry of menuEntries(); track entry.id) {
            <button
              class={['tb-entry', { 'tb-focus': menuEntries()[menuIndex()]?.id === entry.id, 'tb-disabled': entry.disabled, 'tb-special': entry.special }]}
              click={() => choose(entry.id)}
              mouseenter={() => focus(entry.id)}
            >
              <span class="tb-entry-icon">{{ entry.icon || '◆' }}</span>
              <span class="tb-entry-label">{{ entry.label }}</span>
              <span class="tb-entry-hint">{{ entry.hint || '' }}</span>
            </button>
          }
        </div>
        <footer class="rpg-ui-muted">{{ menuEntries()[menuIndex()]?.detail || t('tb.keys') }}</footer>
      </section>
    }

    @if (phase() === 'waiting' && waitingFor()) {
      <div class="rpg-ui-panel tb-target-hint tb-waiting">
        <span class="rpg-ui-eyebrow">{{ t('tb.waitingFor') }}</span>
        <strong>{{ waitingFor()?.player }}</strong>
        <span class="tb-waiting-unit">{{ waitingFor()?.unit }}</span>
        @if (countdown() !== null) {
          <span class={['tb-countdown', { 'tb-urgent': countdown() <= 5 }]}>{{ countdown() }}</span>
        }
      </div>
    }

    @if (targetCard()) {
      <aside class="rpg-ui-panel tb-target-card" aria-label={t('tb.targetInfo')}>
        <div class="tb-member-face" style={faceStyle(targetInfo()?.battler, 46)}></div>
        <div class="tb-target-body">
          <span class="rpg-ui-eyebrow">{{ t('tb.chooseTarget') }}</span>
          <strong class="tb-target-name">{{ targetInfo()?.name }}</strong>
          <div class="tb-stat">
            <span class="tb-stat-key">{{ t('tb.hp') }}</span>
            <div class={['tb-gauge', targetInfo()?.foe ? 'tb-foe-hp' : 'tb-hp']}><i style={{ width: pct(targetInfo()?.hp, targetInfo()?.maxHp) }}></i></div>
            <span class="tb-stat-val">{{ targetInfo()?.known ? targetInfo()?.hp + ' / ' + targetInfo()?.maxHp : '???' }}</span>
          </div>
          @if (targetInfo()?.known && !targetInfo()?.foe) {
            <div class="tb-stat">
              <span class="tb-stat-key">{{ t('tb.sp') }}</span>
              <div class="tb-gauge tb-sp"><i style={{ width: pct(targetInfo()?.sp, targetInfo()?.maxSp) }}></i></div>
              <span class="tb-stat-val">{{ targetInfo()?.sp + ' / ' + targetInfo()?.maxSp }}</span>
            </div>
          }
          @if (targetInfo()?.stagger) {
            <div class="tb-stat">
              <span class="tb-stat-key">{{ t('tb.guardGauge') }}</span>
              <div class={['tb-gauge', 'tb-break', { 'tb-broken': targetInfo()?.stagger?.broken }]}><i style={{ width: guardWidth(targetInfo()) }}></i></div>
              <span class="tb-stat-val">{{ guardText(targetInfo()) }}</span>
            </div>
            <small class="tb-target-help">{{ t(targetInfo()?.stagger?.broken ? 'tb.brokenHelp' : 'tb.breakHelp') }}</small>
          }
          @if (targetInfo()?.known && targetInfo()?.foe && (targetInfo()?.weaknesses.length || targetInfo()?.resists.length)) {
            <div class="tb-target-elements">
              @for (el of targetInfo()?.weaknesses; track el) { <span class="tb-chip tb-chip-weak">{{ t('tb.weak.short') + ' · ' + t('tb.el.' + el) }}</span> }
              @for (el of targetInfo()?.resists; track el) { <span class="tb-chip">{{ t('tb.resist.short') + ' · ' + t('tb.el.' + el) }}</span> }
            </div>
          }
          @if (targetInfo()?.foe && !targetInfo()?.known) {
            <small class="tb-target-help">{{ t('tb.scanHint') }}</small>
          }
        </div>
        <button class="rpg-ui-btn tb-target-back" data-variant="secondary" data-size="small" click={back}>{{ t('tb.back') }}</button>
      </aside>
    }

    @if (targetHint()) {
      <div class="rpg-ui-panel tb-target-hint">
        <span class="rpg-ui-eyebrow">{{ t('tb.chooseTarget') }}</span>
        <strong>{{ targetName() }}</strong>
        <button class="rpg-ui-btn" data-variant="secondary" data-size="small" click={back}>{{ t('tb.back') }}</button>
      </div>
    }

    @if (phase() !== 'closed') {
      <div class="tb-party">
        @for (id of partyIds(); track id) {
          <div class={['rpg-ui-panel', 'tb-member', { 'tb-hit-a': member(id)().hits % 2 === 1, 'tb-hit-b': member(id)().hits > 0 && member(id)().hits % 2 === 0, 'tb-active': actorId() === id, 'tb-dead': member(id)().dead, 'tb-guard': member(id)().guarding, 'tb-limit-full': limitFull(id), 'tb-other': !member(id)().mine }]}>
            <div class="tb-member-face" style={faceStyle(member(id)().battler, 46)}></div>
            <div class="tb-member-body">
              <div class="tb-member-name">{{ member(id)().name }}
                @if (member(id)().tag) {
                  <small class="tb-member-tag">{{ member(id)().tag }}</small>
                }
              </div>
              <div class="tb-stat">
                <span class="tb-stat-key">{{ t('tb.hp') }}</span>
                <div class="tb-gauge tb-hp"><i class="tb-lag" style={{ width: pct(member(id)().hp, member(id)().maxHp) }}></i><i style={{ width: pct(member(id)().hp, member(id)().maxHp) }}></i></div>
                <span class={['tb-stat-val', { 'tb-low': member(id)().hp < member(id)().maxHp * 0.3 }]}>{{ member(id)().hp }}</span>
              </div>
              <div class="tb-stat">
                <span class="tb-stat-key">{{ t('tb.sp') }}</span>
                <div class="tb-gauge tb-sp"><i style={{ width: pct(member(id)().sp, member(id)().maxSp) }}></i></div>
                <span class="tb-stat-val">{{ member(id)().sp }}</span>
              </div>
              <div class="tb-gauge tb-limit"><i style={{ width: pct(member(id)().limit || 0, member(id)().limitMax) }}></i></div>
            </div>
          </div>
        }
      </div>
    }

    @if (cutin()) {
      <div class="tb-cutin" click={skipCutin}>
        <div class="tb-cutin-lines"></div>
        <div class="tb-cutin-band">
          <div class="tb-cutin-face" style={faceStyle(cutin()?.battler, 300)}></div>
          <div class="tb-cutin-text">
            <small>{{ cutin()?.name }}</small>
            <strong>« {{ cutin()?.line }} »</strong>
          </div>
        </div>
        <div class="tb-letterbox tb-top"></div>
        <div class="tb-letterbox tb-bottom"></div>
        <button class="rpg-ui-btn tb-skip" data-variant="ghost" data-size="small" click={skipCutin}>{{ t('tb.skip') }} ▸</button>
      </div>
    }

    @if (phase() === 'result' && result()) {
      <div class={['tb-result', 'tb-' + result()?.outcome]}>
        <div class="tb-result-title">{{ outcomeTitle() }}</div>
        @if (result()?.outcome === 'victory') {
          <section class="rpg-ui-panel tb-result-panel">
            <header class="rpg-ui-eyebrow">{{ t(spectating() ? 'tb.resultTeam' : 'tb.result') }}</header>
            <div class="tb-result-row"><span>{{ t('tb.exp') }}</span><b>{{ shownExp() }}</b></div>
            <div class="tb-result-row"><span>{{ t('tb.gold') }}</span><b>{{ shownGold() }}</b></div>
            <div class="tb-result-row tb-drops"><span>{{ t('tb.drops') }}</span>
              <div>
                @for (drop of drops(); track drop.id) {
                  <em>✦ {{ drop.name }} ×{{ drop.quantity }}</em>
                }
                @if (noDrops()) {
                  <em>{{ t('tb.none') }}</em>
                }
              </div>
            </div>
          </section>
          <div class="tb-bonuses">
            @for (bonus of bonuses(); track bonus.id) {
              <div class="tb-bonus">{{ t('tb.bonus.' + bonus.id) }}</div>
            }
          </div>
        }
        <button class="rpg-ui-btn tb-continue" data-variant="primary" click={close}>{{ t('tb.continue') }} ▸</button>
      </div>
    }

    @if (toast()) {
      <div class="rpg-ui-panel tb-toast">{{ toast()?.text }}</div>
    }
  </div>
</DOMContainer>

<script>
  import { computed } from 'canvasengine'
  import {
    phase, order, previewing, speed, banner, menuTitle, menuLevel, menuEntries, menuIndex,
    targetName, targetInfo, partyIds, member, actorId, cutin, result, toast, reduced, t, faceStyle, shownExp, shownGold, muted,
    waitingFor, countdown, spectating, audience, pvp, surrenderArmed, surrendered,
  } from '../client/state'
  import { chooseEntry, focusEntry, back, cycleSpeed, toggleMuted, skipCutin, close, leaveWatching, surrender } from '../client/session'

  const surrenderLabel = () => t(surrendered() ? 'tb.surrendered' : surrenderArmed() ? 'tb.surrenderConfirm' : 'tb.surrender')
  const drops = () => result()?.items || []
  const bonuses = () => result()?.bonuses || []
  const noDrops = () => drops().length === 0
  const outcomeTitle = () => t({ victory: 'tb.victory', defeat: 'tb.defeat', escape: 'tb.escaped' }[result()?.outcome] || 'tb.victory')
  const limitFull = (id) => { const m = member(id)(); return m.limit !== null && m.limit >= m.limitMax }
  // Both signals are read on every run: a computed only follows the signals its first run read (`&&` would skip one).
  const targetCard = computed(() => {
    const info = targetInfo()
    return phase() === 'target' ? info : null
  })
  const targetHint = computed(() => {
    const info = targetInfo()
    return phase() === 'target' && !info
  })
  const pctNumber = (v, max) => Math.max(0, Math.min(100, (v / Math.max(1, max)) * 100))
  const pct = (v, max) => pctNumber(v, max) + '%'
  // The guard of the target: what is left of it, full when it is broken (the gauge then shows the broken colour).
  const guardWidth = (info) => (info?.stagger?.broken ? '100%' : pct(info?.stagger?.value, info?.stagger?.max))
  const guardText = (info) => (info?.stagger?.broken ? t('tb.broken') : Math.round(pctNumber(info?.stagger?.value, info?.stagger?.max)) + '%')
  const indexOf = (id) => menuEntries().findIndex((e) => e.id === id)
  const choose = (id) => chooseEntry(indexOf(id))
  const focus = (id) => { if (menuIndex() !== indexOf(id)) focusEntry(indexOf(id)) }
</script>
