<span class={['t-area-icon', visual()]} aria-hidden="true">
  @for (cell of cells(); track cell.id) {
    <i class={['', {lit:cell.lit}]}></i>
  }
</span>
<script>
  import { computed } from 'canvasengine'
  const { shape, mask: area, visual } = defineProps()
  const mask = shape => Array.from({length:9}, (_,id) => ({id,lit:shape === 'square' || (shape === 'cross' ? [1,3,4,5,7].includes(id) : shape === 'pierce' ? [1,4].includes(id) : id === 4)}))
  // The area drawn in Studio: its 3 × 3 around the target (the icon is small)
  const drawn = (rows) => { const w = Math.max(...rows.map(r => r.length)), cx = Math.floor(w / 2), cy = Math.floor(rows.length / 2); return Array.from({length:9}, (_,id) => { const c = rows[cy + Math.floor(id / 3) - 1]?.[cx + (id % 3) - 1]; return {id, lit: !!c && c !== '.' && c !== ' ' && c !== '0'} }) }
  const cells = computed(() => area() ? drawn(area()) : mask(shape()))
</script>
