<Text text={label} x={px} y={py} anchor={[0.5, 1]} scale={size} alpha={alpha} visible={shown} style={style} />

<script>
  import { computed } from 'canvasengine'
  import { popupMotion } from '@rpgjs/battle-kit/pure'
  import { field } from '../client/field'

  // One pooled floating number (damage, K.O.), animated by the battle kit.
  const { index } = defineProps()
  const slot = field.popups[index()]
  // CanvasEngine computeds track the signals of their first run: read them all before branching.
  const motion = computed(() => {
    const now = field.time()
    const p = slot()
    return p ? popupMotion(now - p.born) : null
  })
  const shown = computed(() => !!motion() && !motion().done)
  const label = computed(() => slot()?.text ?? '')
  const px = computed(() => slot()?.x ?? 0)
  const py = computed(() => (slot()?.y ?? 0) + (motion()?.y ?? 0))
  const size = computed(() => (motion()?.scale ?? 1) * (slot()?.big ? 1.1 : 1))
  const alpha = computed(() => motion()?.alpha ?? 0)
  const style = computed(() => ({
    fontFamily: 'Georgia, serif',
    fontSize: slot()?.big ? 34 : 28,
    fontWeight: 'bold',
    fill: slot()?.color ?? 0xfff0c5,
    stroke: { color: 0x1b1113, width: 6, join: 'round' },
    dropShadow: { color: 0x000000, alpha: 0.55, blur: 2, distance: 3, angle: Math.PI / 2 },
  }))
</script>
