<Container x={v.x} y={v.y} zIndex={v.y} alpha={v.alpha} visible={v.visible}>
  <Graphics draw={drawRing} />
  <Container scale={spriteScale}>
    <Sprite sheet={{ definition: definition(), playing: v.anim(), params: { direction: v.facing() } }} anchor={anchor} tint={tint} filters={filters} />
  </Container>
  <Graphics draw={drawBar} />
  <Text text={v.partner} y={nameY} anchor={[0.5, 0.5]} style={partnerStyle} />
</Container>

<script>
  import { computed, effect, signal } from 'canvasengine'
  import { inject, RpgClientEngine } from '@rpgjs/client'
  import { BattlerLook } from '@rpgjs/battle-kit'
  import { field } from '../client/field'
  import { battle, unitAnchors, unitScales } from '../client/state'

  // One unit: its battler, the RPGJS spritesheet of its character.
  const { id } = defineProps()
  const v = field.unit(id())
  const engine = inject(RpgClientEngine)
  // The sprite of its character, as the map draws it (stand, walk, attack… and the animations linked to it in the Character Editor).
  const definition = computed(() => engine.getSpriteSheet(v.battler))
  // Units are drawn as the map draws their character (its size on the map), unless the game gave a scale for it.
  const scaleOf = () => unitScales[v.battler] ?? 1
  const spriteScale = computed(() => { const s = scaleOf(); return [s, s] })
  // The feet of the character stay on the ring, standing or walking
  const anchor = computed(() => unitAnchors[v.battler]?.[v.anim()] ?? unitAnchors[v.battler]?.stand ?? [0.5, 0.9])
  // The ring and the bar follow the size of the cells (the tile of the map): 1 on a 64 px cell.
  const k = () => (battle()?.board.cellSize ?? 64) / 64
  // Top of the sprite above the tile centre: the bar sits just above the head.
  const top = computed(() => (field.frames()[v.battler]?.h ?? 48) * scaleOf() * anchor()[1])
  const barY = computed(() => -top() - 4 - 5 * k())
  const nameY = computed(() => barY() - 9)
  const tint = v.tint
  // Coop: a partner's units wear a blue ring and their commander's name.
  const PARTNER = 0x8fb2ff
  // Colours are relative to the local player's side (PvP).
  // Both signals read first: a draw only tracks what its first run reads.
  const accentOf = () => { const mine = v.friendly(), partner = v.partner(); return !mine ? 0xf17b76 : partner ? PARTNER : v.color }
  const partnerStyle = { fontSize: 11, fontWeight: 'bold', fill: PARTNER, stroke: { color: 0x05070a, width: 3 } }

  // Hit flash (brightness), driven by the choreography; the battle kit owns the filter.
  const look = new BattlerLook()
  // Only the filters in use: no filter pass at rest. What the sprite was given is kept apart: reading the signal here would make
  // the effect depend on what it sets.
  const filters = signal([])
  let shown = []
  effect(() => {
    const f = v.flash()
    look.reset()
    if (f > 0) look.brightness(1 + f * 1.4)
    if (look.changed(shown)) filters.set((shown = look.active))
  })

  const drawRing = (g) => {
    const selected = v.selected()
    const acted = v.acted()
    const accent = accentOf()
    const pulse = v.pulse()
    const s = k()
    g.ellipse(0, 0, 25 * s, 10 * s).fill({ color: 0x000000, alpha: 0.45 })
    g.ellipse(0, 0, 27 * s, 11 * s).stroke({ color: accent, width: selected ? 3 : 1.5, alpha: acted ? 0.4 : 0.85 })
    if (pulse > 0) g.ellipse(0, 0, (31 + pulse * 4 - 2) * s, 14 * s).stroke({ color: 0xffeac1, width: 1, alpha: 0.7 })
  }
  const drawBar = (g) => {
    const mine = v.friendly()
    const hp = v.hp()
    const y = barY()
    const w = Math.max(24, 42 * k())
    g.roundRect(-w / 2, y, w, 5, 2).fill({ color: 0x091018, alpha: 0.9 })
    g.roundRect(-w / 2 + 1, y + 1, Math.max(0, (w - 2) * hp), 3, 1).fill(mine ? 0x8ddbd2 : 0xf3867c)
  }
</script>
