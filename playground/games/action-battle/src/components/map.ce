<Container>
  <Sprite image="background.png" width={2048/1.2} height={1536/1.2} />
  <Rect width={2048} height={1536} color="#111827" alpha={0.12} />
  <Rect x={0} y={0} width={2048} height={4} color="#202a33" />
  <Rect x={0} y={1532} width={2048} height={4} color="#202a33" />
  <Rect x={0} y={0} width={4} height={1536} color="#202a33" />
  <Rect x={2044} y={0} width={4} height={1536} color="#202a33" />
  <EventLayerComponent />
  <DOMContainer width="2048px" height="1536px" class="playground-action-battle-root">
    <div class="playground-action-battle">
      <div class="stage-drop" data-active={dragging() ? "true" : "false"}></div>
    </div>
  </DOMContainer>
</Container>

<style>
  /* The DOM layer sets its own inline pointer-events: let clicks reach the panel and the canvas. */
  .playground-action-battle-root {
    pointer-events: none !important;
  }

  .playground-action-battle {
    width: 2048px;
    height: 1536px;
    position: relative;
    font-family: Inter, ui-sans-serif, system-ui, sans-serif;
    pointer-events: none;
  }

  .stage-drop {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .stage-drop[data-active="true"] {
    outline: 2px solid rgba(230, 198, 115, 0.85);
    outline-offset: -10px;
    background: rgba(255, 255, 255, 0.06);
  }
</style>

<script>
  import { EventLayerComponent } from "@rpgjs/client";
  import { dragging } from "../lab-state";
</script>
