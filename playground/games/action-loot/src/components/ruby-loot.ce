<Container scale={scale} rotation={rotation}>
  <Graphics draw={drawRuby} />
</Container>

<script>
  import { computed } from "canvasengine";

  // Draws the pickup only: the engine moves it (arc, magnet, flight).
  const { state, progress } = defineProps({
    state: { default: "idle" },
    progress: { default: 0 },
  });

  const scale = computed(() => (state() === "collecting" ? 1 - progress() * 0.6 : 1.1));
  const rotation = computed(() => (state() === "flying" ? progress() * Math.PI * 2 : 0));

  function drawRuby(g) {
    g.clear();
    g.poly([0, -10, 8, -3, 5, 8, -5, 8, -8, -3]);
    g.fill({ color: 0xc9184a });
    g.stroke({ color: 0x590d22, width: 1.5 });
    g.poly([0, -10, 8, -3, 0, 0, -8, -3]);
    g.fill({ color: 0xff8fa3, alpha: 0.9 });
  }
</script>
