<Container>
  <Sprite image="background.png" width={1024} height={768} />
  <Rect width={1024} height={768} color="#111827" alpha={0.18} />
  <EventLayerComponent />
  <Rect width={1024} height={768} color="#ffffff" alpha={0.001} pointerdown={throwAtPointer} />
</Container>

<script>
  import { mount } from "canvasengine";
  import { EventLayerComponent, inject, RpgClientEngine } from "@rpgjs/client";

  const client = inject(RpgClientEngine);
  let mapContainer = null;

  mount((element) => {
    mapContainer = element.componentInstance;
  });

  // Click: throw the item of hotbar slot 1 (bomb) at the pointer.
  // Shift + click: slot 2 (boomerang). Keys 1 and 2 throw them straight ahead.
  function throwAtPointer(event) {
    const global = event?.global ?? event?.data?.global;
    const local = mapContainer && global ? mapContainer.toLocal(global) : null;
    if (!local || !Number.isFinite(local.x) || !Number.isFinite(local.y)) return;
    client.processAction("action-battle:use-hotbar", {
      slot: event?.shiftKey ? 1 : 0,
      target: { x: local.x, y: local.y },
    });
  }
</script>
